# Fixed credentials and ports for the isolated local/CI E2E stack only.
# Never reuse these values in a shared, staging, or production environment.
BIND_HOST=127.0.0.1
POSTGRES_DB=guanxian
POSTGRES_USER=guanxian
POSTGRES_PASSWORD=e2e-only-postgres-password
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=e2e-minio-admin
MINIO_ROOT_PASSWORD=e2e-only-minio-password
SERVER_PORT=18080
WEB_HTTP_PORT=18082
KEYCLOAK_PORT=18081
SPRING_PROFILES_ACTIVE=e2e
GUANXIAN_JWT_ISSUER_URI=http://127.0.0.1:18081/realms/guanxian-ci
GUANXIAN_JWT_JWK_SET_URI=http://keycloak:8080/realms/guanxian-ci/protocol/openid-connect/certs
GUANXIAN_STORAGE_ENDPOINT=http://minio:9000
GUANXIAN_STORAGE_ACCESS_KEY=e2e-minio-admin
GUANXIAN_STORAGE_SECRET_KEY=e2e-only-minio-password
GUANXIAN_STORAGE_REDIS_URL=redis://redis:6379
WEB_OIDC_AUTHORITY=http://127.0.0.1:18081/realms/guanxian-ci
WEB_OIDC_CLIENT_ID=guanxian-web
WEB_OIDC_REDIRECT_URI=http://127.0.0.1:18082/auth/callback
WEB_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:18082/login
WEB_OIDC_SCOPE=openid profile email
