VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=15000
# 本地后端地址；不填写时由 Vite 直接访问同源 /api/v1
VITE_API_PROXY=http://localhost:8080
# 仅供本地 Vite 开发代理连接 demo 后端；不会进入浏览器生产构建。
DEV_API_PROXY_AUTH_SYSTEM_ADMIN=
DEV_API_PROXY_AUTH_ASSOCIATION_ADMIN=
DEV_API_PROXY_AUTH_ASSOCIATION_OPERATOR=
DEV_API_PROXY_AUTH_ENTERPRISE_ADMIN=
DEV_API_PROXY_AUTH_ENTERPRISE_MEMBER=
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://identity.example.com/realms/guanxian
VITE_OIDC_CLIENT_ID=guanxian-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile email
